# MySQL connection parameters
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=sis_db

# MySQL connection string — format: mysql+pymysql://user:password@host:port/dbname
DATABASE_URL=mysql+pymysql://root:your_mysql_password@127.0.0.1:3306/sis_db

# Required in production: Strong random secret key for JWT token signing (do NOT use default fallback)
JWT_SECRET_KEY=<strong-random-secret>

# Environment mode: 'development' or 'production'
FLASK_ENV=development

# Allowed CORS origins (comma-separated list, wildcard '*' is rejected in production)
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,https://sis-portal-gold.vercel.app
